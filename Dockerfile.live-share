# Live Share WebSocket service, buildable from the frontend repository alone (used by Render, Fly.io, etc.):
#   docker build -f Dockerfile.live-share -t dltools-live-share .
FROM node:22-alpine
WORKDIR /app
RUN npm install --omit=dev --no-save --no-package-lock ws@8 tsx@4
COPY src/lib/live-share ./src/lib/live-share
COPY live-share-server ./live-share-server
ENV NODE_ENV=production PORT=4040 LIVE_SHARE_TRUST_PROXY=true
EXPOSE 4040
USER node
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:${PORT}/healthz || exit 1
CMD ["npx", "tsx", "live-share-server/main.ts"]
